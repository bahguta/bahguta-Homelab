# Copia este fichero como ".env" (junto a docker-compose.yml) y rellena tus valores.
# .env esta en .gitignore: NUNCA lo subas al repositorio.

# --- Base de datos (debe coincidir con POSTGRES_PASSWORD de config/postgres/.env)
DB_USER=bahguta
DB_PASSWORD=change-me
# DB_URL=jdbc:postgresql://postgres:5432/bahguta

# --- Prometheus
BAHGUTA_PROMETHEUS_URL=http://prometheus.example.lan:9090

# --- Tiempo (https://openweathermap.org/api)
BAHGUTA_WEATHER_API_KEY=your-openweather-api-key
BAHGUTA_WEATHER_CITY=Madrid
BAHGUTA_WEATHER_COUNTRY=ES

# --- Omada (opcional)
BAHGUTA_OMADA_URL=https://omada.example.lan
BAHGUTA_OMADA_USERNAME=bahguta-api
OMADA_API_PASSWORD=change-me
BAHGUTA_OMADA_INSECURE_TLS=false
