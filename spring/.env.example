# Copia este fichero a .env y rellénalo. NO subas .env al repositorio.
# Copy this file to .env and fill it in. Do NOT commit .env.

# Base de datos / Database (DB_PASSWORD debe coincidir con POSTGRES_PASSWORD de config/postgres/.env)
DB_URL=jdbc:postgresql://postgres:5432/bahguta
DB_USER=bahguta
DB_PASSWORD=

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# OpenWeather
WEATHER_API_KEY=
WEATHER_CITY=Madrid
WEATHER_COUNTRY=ES

# TP-Link Omada (opcional / optional)
OMADA_URL=
OMADA_USERNAME=
OMADA_API_PASSWORD=
OMADA_INSECURE_TLS=false
OMADA_SITE=

# Docker: clave para arrancar/parar contenedores (la misma en la tablet, Secrets.h)
# Docker: key to start/stop containers (same value in the tablet's Secrets.h)
# Genera / Generate: openssl rand -hex 32
BAHGUTA_API_KEY=
# Nombres de contenedor permitidos, separados por comas y sin espacios
# Allowed container names, comma-separated, no spaces. Example: grafana,prometheus
DOCKER_ALLOWED=
